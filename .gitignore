# vscode
.vscode

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Local env / keys
.env
.env.*
!.env.example
!plus-service/.env.example
*.pem
*.p8
AuthKey_*.p8
tmp-play-store/

# Local throwaway vault (may contain secrets)
test_vault/

# Regenerable screenshot dogfood vault (seed with scripts/seed-demo-vault.mjs)
docs/media/demo-vault/

# Plus service local
plus-service/node_modules/
plus-service/.env
plus-service/data/
test_vault
firepit-log.txt

# Claude Code personal overrides (not shared)
.claude/settings.local.json

# compound-engineering local (machine-specific) config
.compound-engineering/config.local.yaml
graphify-out/

# Throwaway vault used for the /setup install walkthrough
new vault/

# Scratch dist for the Field notes archive test (it must never write www/dist,
# which is the artifact `pages deploy` ships).
www/dist-archive-test/

# Signing keys, anywhere in the tree. Losing an upload keystore means losing the
# ability to update the app on Play; committing one is worse.
keystore.properties
*.jks
*.keystore
*.p12
