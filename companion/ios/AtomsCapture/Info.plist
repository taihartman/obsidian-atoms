	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.tryatoms.capture</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>atomscapture</string>
			</array>
		</dict>
