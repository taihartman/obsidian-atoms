<?xml version="1.0" encoding="utf-8"?>
<!--
  Sideload only. All-files access is what lets the app find Obsidian vaults
  without the user pointing at a folder, and Play grants it only to file
  managers, backup, and antivirus apps. It must never reach the play flavor.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application android:requestLegacyExternalStorage="true" />
</manifest>
