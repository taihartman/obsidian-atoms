# Copy to keystore.properties (gitignored) and point it at your upload keystore.
# The keystore and these passwords never go in git. Losing the keystore means
# losing the ability to update the app on Play, so back it up somewhere safe.
#
# Generate one with:
#   keytool -genkeypair -v -keystore ~/keystores/atoms-capture-upload.jks \
#     -alias atoms-capture -keyalg RSA -keysize 2048 -validity 10000

storeFile=/absolute/path/to/atoms-capture-upload.jks
storePassword=
keyAlias=atoms-capture
keyPassword=
