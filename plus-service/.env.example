# Copy to .env (not committed) and fill in.

ANTHROPIC_API_KEY=
# Optional model / effort overrides (prod default: claude-sonnet-5, API effort high)
# ATOMS_PLUS_MODEL=claude-sonnet-5
# ATOMS_PLUS_EFFORT=high
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787

# development | production — production refuses dogfood + requires Stripe + DATABASE_URL
# ATOMS_PLUS_ENV=production

# Store: memory (default tests) | sqlite (local durable) | postgres (prod / multi-instance)
# ATOMS_PLUS_STORE=sqlite
# ATOMS_PLUS_DATABASE_PATH=./data/plus.sqlite
# DATABASE_URL=postgres://user:pass@host:5432/atoms_plus

# Dogfood: grant trial on first magic-link without Stripe (must be 0 in production)
DOGFOOD_AUTO_GRANT=1
DOGFOOD_GRANT_STATUS=trialing

# Stripe test mode (from Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# From: node scripts/create-stripe-catalog.mjs
STRIPE_PRICE_MONTHLY=price_
STRIPE_PRICE_YEARLY=price_
STRIPE_PRICE_TOPUP=price_

# Force instant grants even when Stripe is configured (local only)
# STRIPE_DOGFOOD_CHECKOUT=1

# Resend (required when ATOMS_PLUS_ENV=production)
# RESEND_API_KEY=re_
# ATOMS_PLUS_EMAIL_FROM=Atoms Plus <plus@tryatoms.app>

# Promo codes — empty default in production; dogfood default FOUNDING=2
# ATOMS_PLUS_PROMOS=FOUNDING=2

# Ask / atom mirror (AES-256-GCM). Required when ATOMS_PLUS_ENV=production.
# openssl rand -hex 32
# ATOMS_ASK_MIRROR_KEY=

# Even G2 private surface. Keep disabled through schema deployment and rollback validation.
G2_ENABLED=0
# Exact packaged-app origin; no wildcard or comma-separated origins.
# Record this request Origin from the installed Private/Beta WebView; it is not the manifest destination.
# G2_APP_ORIGIN=https://<origin-recorded-from-the-private-beta-webview>
# Dedicated least-privilege provider credentials; never reuse the Ask/classify key.
# G2_OPENAI_API_KEY=
# G2_ANTHROPIC_API_KEY=
# G2_TRANSCRIPTION_ENABLED=1
# G2_PROVIDER_CONTROLS_ACCEPTED=2026-09-09
# G2_RETENTION_DISCLOSURE_VERSION=g2-retention-v1
# AES-256-GCM keys: openssl rand -hex 32. Write with current; previous is read-only during rotation.
# G2_DATA_KEY_CURRENT=
# G2_DATA_KEY_CURRENT_VERSION=k1
# G2_DATA_KEY_PREVIOUS=
# G2_DATA_KEY_PREVIOUS_VERSION=
# G2_TRANSCRIPT_RETENTION_HOURS=24
# G2_SWEEP_INTERVAL_MS=60000
