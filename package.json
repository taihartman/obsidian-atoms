{
	"name": "obsidian-atoms",
	"version": "0.6.93",
	"description": "Classify past daily-note captures into atomic notes via Anthropic API",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"spike:api": "node scripts/spike-api.mjs",
		"trial:people": "node scripts/trial-people.mjs",
		"seed:vault": "node scripts/seed-test-vault.mjs",
		"seed:demo": "node scripts/seed-demo-vault.mjs",
		"pretest": "npm run build:www",
		"test": "npm run typecheck:test && vitest run",
		"typecheck:test": "tsc -noEmit -skipLibCheck -p tsconfig.test.json",
		"test:watch": "vitest",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"build:www": "node www/build.mjs",
		"field-notes:test": "node scripts/field-notes-send.mjs test",
		"field-notes:broadcast": "node scripts/field-notes-send.mjs broadcast",
		"measure:cost": "node scripts/measure-classify-cost.mjs",
		"measure:recall": "node scripts/measure-shortlist-recall.mjs",
		"measure:links": "node scripts/measure-link-quality.mjs",
		"measure:chrono": "node scripts/measure-chrono-linking.mjs",
		"measure:hops": "node scripts/measure-hop-distance.mjs",
		"measure:expansion": "node scripts/measure-doc-expansion.mjs"
	},
	"keywords": [
		"obsidian",
		"plugin"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"happy-dom": "^20.11.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"obsidian-daily-notes-interface": "^0.9.4"
	}
}
